+    /*
+     * Eriri: wait for a lock instead of failing immediately.
+     *
+     * The library keeps one connection per thread (the discoverer, each parser
+     * worker, ...) and its transactions use BEGIN EXCLUSIVE, so a write from
+     * one thread collides with a read or a write from another. Without a busy
+     * timeout SQLite reports SQLITE_BUSY at once, which makes the discovery
+     * abort half way through -- while still reporting completion -- and makes
+     * an escaping sqlite exception terminate the whole process.
+     */
+    sqlite3_busy_timeout( dbConnection, 5000 );
+
