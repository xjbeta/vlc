From 1b37edb16cc785024a15500ee0fde26b957373a5 Mon Sep 17 00:00:00 2001
From: xjbeta <xjbeta.tiny@gmail.com>
Date: Mon, 12 Oct 2026 03:30:45 +0800
Subject: [PATCH] medialibrary: log metadata extraction tasks (temporary
 diagnostic)

---
 modules/misc/medialibrary/MetadataExtractor.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/modules/misc/medialibrary/MetadataExtractor.cpp b/modules/misc/medialibrary/MetadataExtractor.cpp
index 5cf9762bff..149c6c7256 100644
--- a/modules/misc/medialibrary/MetadataExtractor.cpp
+++ b/modules/misc/medialibrary/MetadataExtractor.cpp
@@ -181,6 +181,10 @@ void MetadataExtractor::onParserEnded(vlc_preparser_req *req, int status, void *
 {
     auto* ctx = static_cast<ParseContext*>( data );
 
+    /* ERI-DIAG: temporary, remove once the indexing gap is understood */
+    fprintf( stderr, "[ERI-DIAG] ended   %s preparser_status=%d\n",
+             ctx->item.mrl().c_str(), status );
+
     vlc::threads::mutex_locker lock( ctx->mde->m_mutex );
     if (status == VLC_SUCCESS) {
         if (ctx->item.fileType() == medialibrary::IFile::Type::Playlist
@@ -232,6 +236,9 @@ void MetadataExtractor::onAttachmentsAdded( vlc_preparser_req *,
 
 medialibrary::parser::Status MetadataExtractor::run( medialibrary::parser::IItem& item )
 {
+    /* ERI-DIAG: temporary */
+    fprintf( stderr, "[ERI-DIAG] start   %s\n", item.mrl().c_str() );
+
     ParseContext ctx( this, item );
 
     auto inputItem = vlc::wrap_cptr(input_item_New(item.mrl().c_str(), NULL),
@@ -277,6 +284,10 @@ medialibrary::parser::Status MetadataExtractor::run( medialibrary::parser::IItem
         m_currentCtx = nullptr;
     }
 
+    /* ERI-DIAG: temporary */
+    fprintf( stderr, "[ERI-DIAG] result  %s status=%d\n",
+             item.mrl().c_str(), (int)ctx.status );
+
     return ctx.status;
 }
 
