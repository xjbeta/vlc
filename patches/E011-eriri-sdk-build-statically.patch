From b98546de97df390d5d891b25d695fe04ecd59ec1 Mon Sep 17 00:00:00 2001
From: Eriri CI <eriri-ci@localhost>
Date: Fri, 16 Oct 2026 17:02:59 +0800
Subject: [PATCH] eriri-sdk: build the SDK statically (E011)

build.sh without --enable-shared is what folds every plugin into
lib/libvlc-full-static.a, which eriri/make-vlc-framework.sh links into one
libvlc.framework. --enable-vlc forces --enable-partial-linking here; configure
rejects the combination otherwise.
---
 eriri/vlc.conf | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/eriri/vlc.conf b/eriri/vlc.conf
index 0e703ec58d..9e5bdcfc5a 100644
--- a/eriri/vlc.conf
+++ b/eriri/vlc.conf
@@ -63,6 +63,14 @@ export VLC_CONFIG_OPTIONS_MACOSX=(
     # is the IPC around it that breaks -- and VLCKit on Apple platforms uses
     # the in-process path for the same reason.
     --disable-external-preparser
+    # Eriri: the SDK is a static build (build.sh without --enable-shared), and a
+    # static build with --enable-vlc requires partial linking -- configure
+    # refuses the combination otherwise ("VLC requires partial linking to build
+    # with static plugins"). Partial linking merges every plugin and its static
+    # dependencies into lib/vlc/libvlc_static_modules.a, which build.sh then
+    # folds into lib/libvlc-full-static.a; eriri/make-vlc-framework.sh links
+    # that archive into one libvlc.framework.
+    --enable-partial-linking
 )
 
 # Additional configure options for iOS
