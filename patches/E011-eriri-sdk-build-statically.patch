From ba7203fd7adc707a7c09560f94aa91ac08147edb Mon Sep 17 00:00:00 2001
From: Eriri CI <eriri-ci@localhost>
Date: Sat, 17 Oct 2026 05:24:57 +0800
Subject: [PATCH] eriri-sdk: build the SDK statically (E011)

build.sh without --enable-shared is what folds every plugin into
lib/libvlc-full-static.a, which eriri/make-vlc-framework.sh links into one
libvlc.framework. --enable-partial-linking is requested explicitly: it is what
localizes per-plugin symbols, without which three plugins that each embed their
own JSON parser collide on _json_parse_error/_json_read at the final link.
---
 eriri/vlc.conf | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/eriri/vlc.conf b/eriri/vlc.conf
index 7a12093b81..477e6dcdad 100644
--- a/eriri/vlc.conf
+++ b/eriri/vlc.conf
@@ -58,6 +58,16 @@ export VLC_CONFIG_OPTIONS_BASE=(
 # loudly if the contrib is missing, instead of silently shipping without it.
 export VLC_CONFIG_OPTIONS_MACOSX=(
     --enable-medialibrary
+    # Eriri: partial linking, requested explicitly. It merges every plugin and
+    # its static dependencies into lib/vlc/libvlc_static_modules.a (so
+    # lib/vlc/plugins is left empty and build.sh needs E010 to find the module
+    # table there), and -- the reason it is not optional -- it localizes each
+    # plugin's non-entry symbols. That is what stops the three plugins which
+    # each embed their own JSON parser from colliding on _json_parse_error and
+    # _json_read at the final link; without it ld64 stops with "2 duplicate
+    # symbols". configure only insists on partial linking when --enable-vlc is
+    # on, which is why the pairing is easy to lose by accident.
+    --enable-partial-linking
 )
 
 # Additional configure options for iOS
