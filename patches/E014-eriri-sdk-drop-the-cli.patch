From c2fe404ca3ad46b56e5f191fa361346bc6fd89e9 Mon Sep 17 00:00:00 2001
From: Eriri CI <eriri-ci@localhost>
Date: Sat, 17 Oct 2026 05:25:32 +0800
Subject: [PATCH] eriri-sdk: drop the CLI, keep partial linking (E014)

The SDK ships no CLI. With --enable-vlc, bin/ builds a static vlc-osx and the
SDK may or may not end up with it, depending on whether install-data-local wins
its race against install-exec-am -- so the SDK's contents were not
deterministic. E003 made that race survivable; this removes it.

Partial linking stays, now requested for its own sake rather than as a
consequence of --enable-vlc. It is what localizes each plugin's non-entry
symbols, and three plugins each embed their own JSON parser: without it the
final link stops with duplicate _json_parse_error / _json_read.
---
 eriri/vlc.conf | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/eriri/vlc.conf b/eriri/vlc.conf
index bec097833a..4756d73ebe 100644
--- a/eriri/vlc.conf
+++ b/eriri/vlc.conf
@@ -19,13 +19,14 @@ export VLC_CONFIG_OPTIONS_BASE=(
     --enable-lua
     --disable-qt
     --disable-skins2
-    # Eriri: upstream's Apple base options disable this, but the medialibrary
-    # browses directories through the out-of-process preparser, which lives in
-    # libexec/vlc/vlc-preparser and is only built when BUILD_VLC is true
-    # (bin/preparser/Makefile.am). VLC's own macOS SDK builds it, and without it
-    # discovery fails with "Failed to browse directory" / "Fail to create
-    # Process in process_pool".
-    --enable-vlc
+    # Eriri: --disable-vlc. The SDK ships no CLI and nothing consumes one. With
+    # it on, bin/ builds a static vlc-osx and the SDK may or may not end up
+    # installing it, depending on whether install-data-local wins its race
+    # against install-exec-am -- so the SDK's own contents were not
+    # deterministic. The medialibrary does not need it either: it runs the
+    # preparser in-process. Partial linking, the one part of --enable-vlc this
+    # build actually wanted, is requested explicitly below.
+    --disable-vlc
     --disable-vlm
     --disable-nls
     --disable-notify
-- 
