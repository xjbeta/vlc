From 2b3f1c5308606ec1e9ce04e6259e028b76ebf25d Mon Sep 17 00:00:00 2001
From: xjbeta <xjbeta.tiny@gmail.com>
Date: Mon, 12 Oct 2026 02:24:04 +0800
Subject: [PATCH] medialibrary: log file stat failures (temporary diagnostic)

---
 modules/misc/medialibrary/fs/directory.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/modules/misc/medialibrary/fs/directory.cpp b/modules/misc/medialibrary/fs/directory.cpp
index 98cfa35802..3f95fd8c4d 100644
--- a/modules/misc/medialibrary/fs/directory.cpp
+++ b/modules/misc/medialibrary/fs/directory.cpp
@@ -250,6 +250,10 @@ SDDirectory::addFile(std::string mrl, IFile::LinkedFileType fType, std::string l
 
         if ( vlc_stat( path.get(), &stat ) != 0 )
         {
+            /* ERI-DIAG: temporary, remove once the indexing gap is understood */
+            fprintf( stderr, "[ERI-DIAG] stat failed mrl=%s path=%s errno=%d (%s)\n",
+                     mrl.c_str(), path.get() != NULL ? path.get() : "(null)",
+                     errno, strerror( errno ) );
             if ( errno == EACCES )
                 return;
             throw errors::System{ errno, "Failed to get file info" };
