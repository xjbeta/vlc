From 12971846ffea7646081449556c806c816ad644c5 Mon Sep 17 00:00:00 2001
From: xjbeta <xjbeta.tiny@gmail.com>
Date: Sat, 17 Oct 2026 05:05:08 +0800
Subject: [PATCH] bin: tolerate a missing vlc-osx when renaming it at install
 time

---
 bin/Makefile.am | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/bin/Makefile.am b/bin/Makefile.am
index 24406df930..bedb298a15 100644
--- a/bin/Makefile.am
+++ b/bin/Makefile.am
@@ -147,8 +147,16 @@ MOSTLYCLEANFILES = $(noinst_DATA)
 
 if HAVE_OSX
 if BUILD_VLC
+# Eriri: install-data-local runs before install-exec-am has created
+# $(DESTDIR)$(bindir), so the original `cd ...; mv vlc-osx vlc` failed its cd
+# and then renamed the *build tree's* vlc-osx instead -- after which
+# install-binPROGRAMS failed with "vlc-osx: No such file or directory". Only
+# ever rename the file that is actually installed, and never touch the build
+# tree.
 install-data-local:
-	cd "$(DESTDIR)$(bindir)"; mv vlc-osx vlc
+	@if [ -f "$(DESTDIR)$(bindir)/vlc-osx" ]; then \
+		cd "$(DESTDIR)$(bindir)" && mv vlc-osx vlc; \
+	fi
 
 endif
 endif
-- 
