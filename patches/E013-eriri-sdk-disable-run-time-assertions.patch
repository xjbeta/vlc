From 6ccec36e4b2d67f4d182bd9b9f2800c5d8d2f094 Mon Sep 17 00:00:00 2001
From: Eriri CI <eriri-ci@localhost>
Date: Sat, 17 Oct 2026 05:25:08 +0800
Subject: [PATCH] eriri-sdk: turn off VLC's run-time assertions (E013)

configure.ac defaults enable_debug to yes, so every assert() in VLC is live and
aborts the host process rather than returning gracefully. SwiftVLC ships
--disable-debug for the same reason.

This covers VLC's own code only. The medialibrary is a contrib built by the
contrib system, so --disable-debug does not reach it: E008 stays.
---
 eriri/vlc.conf | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/eriri/vlc.conf b/eriri/vlc.conf
index 477e6dcdad..bec097833a 100644
--- a/eriri/vlc.conf
+++ b/eriri/vlc.conf
@@ -10,6 +10,12 @@ export VLC_CONFIG_OPTIONS_BASE=(
     --disable-vcd
     --disable-macosx
     --disable-macosx-avfoundation
+    # Eriri: upstream defaults to run-time assertions ENABLED (configure.ac:
+    # enable_debug="yes"), so any assert() in VLC aborts the host process instead
+    # of returning gracefully. SwiftVLC ships --disable-debug for the same
+    # reason. This defines NDEBUG for VLC's own code only -- the medialibrary is
+    # a contrib with its own build and keeps its exception guards via E008.
+    --disable-debug
     --enable-lua
     --disable-qt
     --disable-skins2
-- 
