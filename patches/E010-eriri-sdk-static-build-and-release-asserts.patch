From e694ff86fa03f91cbcd7a6bd31d856b3dded1d61 Mon Sep 17 00:00:00 2001
From: Eriri CI <eriri-ci@localhost>
Date: Sat, 17 Oct 2026 04:40:48 +0800
Subject: [PATCH] eriri-sdk: drop --enable-vlc, disable VLC's run-time
 assertions (E010)

A static build with --enable-vlc is forced into partial linking: every plugin
ends up merged into lib/vlc/libvlc_static_modules.a, lib/vlc/plugins is left
empty (so build.sh's module-table step needs the E010 workaround), and ld64
refuses the -dead_strip that configure puts in LDFLAGS next to -r (E012).
Nothing here ships a CLI, and the medialibrary's preparser runs in-process, so
none of it is wanted. This is the configuration VLCKit and SwiftVLC use.

Also turn off VLC's own run-time assertions: upstream enables them by default,
so an assert() aborts the host process instead of returning gracefully. The
medialibrary contrib is a separate build and keeps its guards through E008.
---
 eriri/vlc.conf | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/eriri/vlc.conf b/eriri/vlc.conf
index 0e703ec58d..748620a9e6 100644
--- a/eriri/vlc.conf
+++ b/eriri/vlc.conf
@@ -13,10 +13,21 @@ export VLC_CONFIG_OPTIONS_BASE=(
     --enable-lua
     --disable-qt
     --disable-skins2
-    # Eriri: kept for parity with VLC's own macOS SDK, which builds the vlc
-    # binary and libexec/vlc/vlc-preparser. Note the out-of-process preparser
-    # itself is disabled below.
-    --enable-vlc
+    # Eriri: --disable-vlc. Nothing here ships a CLI, and a *static* build with
+    # --enable-vlc is forced into partial linking (configure rejects the
+    # combination otherwise): every plugin gets merged into
+    # lib/vlc/libvlc_static_modules.a, lib/vlc/plugins is left empty, and ld64
+    # refuses the -dead_strip that configure puts in LDFLAGS next to -r. Without
+    # it the plugins stay individual .a files, build.sh's own module-table step
+    # works untouched, and none of that machinery is needed. The medialibrary
+    # does not need the CLI either: its preparser runs in-process (see below).
+    --disable-vlc
+    # Eriri: upstream defaults to run-time assertions ENABLED, so any assert()
+    # in VLC aborts the host process instead of returning gracefully. SwiftVLC
+    # ships --disable-debug for the same reason. This defines NDEBUG for VLC's
+    # own code only -- the medialibrary is a contrib with its own build, and
+    # keeps its exception guards through E008.
+    --disable-debug
     --disable-vlm
     --disable-nls
     --disable-notify
-- 
