From 9e8dfc8a225c4c9e741c95d42134a605fe15b921 Mon Sep 17 00:00:00 2001
From: Eriri CI <eriri-ci@localhost>
Date: Fri, 16 Oct 2026 18:28:08 +0800
Subject: [PATCH] eriri-sdk: drop -dead_strip from the partial link (E012)

ld64 refuses -dead_strip together with -r, and configure puts -dead_strip in
LDFLAGS on Mach-O as the counterpart of --gc-sections. A static build with
--enable-vlc uses partial linking, so every plugin object failed to build:

    ld: -r and -dead_strip cannot be used together

Filtering it out for this step loses nothing: the partial link is not the final
link, and the archive built from its output is dead-stripped when it is.
---
 modules/static.mk | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/modules/static.mk b/modules/static.mk
index f188691383..4a7d1b8620 100644
--- a/modules/static.mk
+++ b/modules/static.mk
@@ -14,6 +14,15 @@ if HAVE_DARWIN
 PARTIAL_LINK_EXPORT_FLAGS += -Wl,-exported_symbol,_vlc_entry*
 endif
 
+# Eriri: ld64 refuses -dead_strip together with -r, and configure puts
+# -dead_strip in LDFLAGS on Mach-O (configure.ac, as the Mach-O counterpart of
+# --gc-sections). Dropping it for the partial link below loses nothing: this is
+# not the final link, and whatever consumes these objects is dead-stripped when
+# it is. (The comma is spelled through a variable because make splits function
+# arguments on commas.)
+vlc_partial_link_comma := ,
+PARTIAL_LINK_DROP_FLAGS = -Wl$(vlc_partial_link_comma)-dead_strip -dead_strip
+
 .PRECIOUS: $(PARTIAL_PLUGINS) $(PLUGINS:.la=.la.symbollist) $(PARTIAL_PLUGINS:=.symbollist) \
 	$(PARTIAL_PLUGINS:%.partial.la=.deps/%.partial.la.o)
 
@@ -34,7 +43,7 @@ endif
 	vlc_entrypoint=`$(NM) ".libs/$${libpath}" | \
 		awk '$$2 == "T" && $$3 ~ /^_?vlc_entry__[A-Za-z0-9_]+$$/ { print $$3; exit }'`; \
 	static_dependencies=`$(top_srcdir)/buildsystem/dependencies.sh static $<`; \
-	$(CXX) $(CXXFLAGS) $(LDFLAGS) \
+	$(CXX) $(CXXFLAGS) $(filter-out $(PARTIAL_LINK_DROP_FLAGS),$(LDFLAGS)) \
 		-r -o $@ -fPIC \
 		$(FORCE_GROUP_ALLOCATION_LDFLAGS) \
 		$(PARTIAL_LINK_EXPORT_FLAGS) \
-- 
