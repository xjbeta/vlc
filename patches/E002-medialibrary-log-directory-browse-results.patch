From bc2fdf6af5da0716bd3bfdee37d4a772449bba27 Mon Sep 17 00:00:00 2001
From: xjbeta <xjbeta.tiny@gmail.com>
Date: Mon, 12 Oct 2026 03:12:42 +0800
Subject: [PATCH] medialibrary: log directory subitem types (temporary
 diagnostic)

---
 modules/misc/medialibrary/fs/directory.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/modules/misc/medialibrary/fs/directory.cpp b/modules/misc/medialibrary/fs/directory.cpp
index 98cfa35802..c93b7b672a 100644
--- a/modules/misc/medialibrary/fs/directory.cpp
+++ b/modules/misc/medialibrary/fs/directory.cpp
@@ -215,6 +215,8 @@ SDDirectory::read() const
     {
         const char* mrl = m.get()->psz_uri;
         enum input_item_type_e type = m->i_type;
+        /* ERI-DIAG: temporary */
+        fprintf( stderr, "[ERI-DIAG]   child type=%d uri=%s\n", (int)type, mrl );
         if ( type == ITEM_TYPE_DIRECTORY )
         {
             m_dirs.push_back( std::make_shared<SDDirectory>( mrl, m_fs ) );
@@ -234,6 +236,9 @@ SDDirectory::read() const
         }
     }
 
+    /* ERI-DIAG: temporary */
+    fprintf( stderr, "[ERI-DIAG] read %s files=%zu dirs=%zu\n",
+             m_mrl.c_str(), m_files.size(), m_dirs.size() );
     m_read_done = true;
 }
 
